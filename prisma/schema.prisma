// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["omitApi"]
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model User {
    id             Int        @id @default(autoincrement())
    createdAt      DateTime   @default(now()) @map("created_at")
    lastModifiedAt DateTime   @updatedAt @map("last_modified_at")
    email          String     @unique
    admin          Boolean    @default(false)
    dramasCreated  Drama[]    @relation("drama_created_by")
    dramasModified Drama[]    @relation("drama_modified_by")
    tags           Tag[]
    linksCreated   Link[]
    activity       Activity[]
    watched        Watched[]

    @@map("user")
}

model Drama {
    id               Int       @id @default(autoincrement())
    createdAt        DateTime  @default(now()) @map("created_at")
    createdById      Int       @map("created_by_id")
    createdBy        User      @relation("drama_created_by", fields: [createdById], references: [id], onDelete: Cascade)
    lastModifiedAt   DateTime  @updatedAt @map("last_modified_at")
    lastModifiedById Int       @map("modified_by_id")
    lastModifiedBy   User      @relation("drama_modified_by", fields: [lastModifiedById], references: [id])
    title            String    @default("")
    description      String    @default("")
    startedAiringAt  DateTime? @map("started_airing_at")
    finishedAiringAt DateTime? @map("finished_airing_at")
    country          String?
    episodeDuration  Int?      @map("episode_duration")
    episodeCount     Int?      @map("episode_count")
    // Upcoming, Ongoing, Completed,  Completed - Missing Subs
    status           String    @default("Upcoming")
    links            Link[]
    tags             Tag[]
    watched          Watched[]

    @@map("drama")
}

model Watched {
    id             Int      @id @default(autoincrement())
    createdAt      DateTime @default(now()) @map("created_at")
    createdById    Int      @map("created_by_id")
    createdBy      User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
    lastModifiedAt DateTime @updatedAt @map("last_modified_at")
    dramaId        Int      @map("drama_id")
    drama          Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)
    // maybe, yes, no, dropped
    status         String?

    @@unique([createdById, dramaId])
    @@map("watched")
}

model Link {
    id          Int      @id @default(autoincrement())
    createdAt   DateTime @default(now()) @map("created_at")
    createdById Int      @map("created_by_id")
    createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
    dramaId     Int      @map("drama_id")
    drama       Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)
    url         String

    @@map("link")
}

model Tag {
    id          Int      @id @default(autoincrement())
    createdAt   DateTime @default(now()) @map("created_at")
    createdById Int      @map("created_by_id")
    createdBy   User     @relation(fields: [createdById], references: [id])
    dramaId     Int      @map("drama_id")
    drama       Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)
    name        String

    @@unique([createdById, dramaId, name])
    @@map("tag")
}

// to track history?
// ex added link <>
model Activity {
    id          Int      @id @default(autoincrement())
    createdAt   DateTime @default(now()) @map("created_at")
    createdById Int      @map("created_by_id")
    createdBy   User     @relation(fields: [createdById], references: [id])
    // not a fks as we want to keep these even when we delete things
    dramaId     Int?     @map("drama_id")

    message String

    @@map("activity")
}
