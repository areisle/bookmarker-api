{
    "name": "bookmarker-api",
    "version": "0.3.0",
    "description": "api for chrome extension for bookmarks shared between users",
    "main": "index.js",
    "scripts": {
        "test": "jest",
        "build": "tsc; cp src/schema.graphql build",
        "db:migrate": "npx prisma migrate dev",
        "db:setup": "prisma migrate dev && prisma db seed",
        "db:start": "docker-compose up",
        "start": "node build/index.js",
        "start:dev": "ts-node-dev src/index.ts",
        "generate-types": "graphql-codegen --config codegen.yml"
    },
    "keywords": [],
    "author": "areisle@gmail.com",
    "license": "ISC",
    "devDependencies": {
        "@graphql-codegen/cli": "2.2.0",
        "@graphql-codegen/typescript": "2.2.2",
        "@graphql-codegen/typescript-resolvers": "2.3.0",
        "@types/jest": "^27.0.2",
        "@types/lodash.startcase": "^4.4.7",
        "@types/node": "16.10.2",
        "@types/uuid": "^8.3.1",
        "jest": "^27.3.0",
        "prisma": "^6.1.0",
        "ts-jest": "^27.0.7",
        "ts-node": "10.2.1",
        "ts-node-dev": "1.1.8",
        "uuid": "^8.3.2"
    },
    "dependencies": {
        "@prisma/client": "^6.1.0",
        "@types/lodash.without": "^4.4.7",
        "apollo-server": "3.3.0",
        "firebase-admin": "^10.0.0",
        "graphql": "15.6.1",
        "lodash.startcase": "^4.4.0",
        "lodash.without": "^4.4.0",
        "typescript": "5.7.3"
    },
    "prisma": {
        "seed": "node prisma/seed.js"
    }
}
